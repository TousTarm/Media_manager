# Vzor konfigurace. Zkopíruj na .env a vyplň — .env je v .gitignore a na
# cílový stroj se nekopíruje z repa, vytváří se ručně při nasazení.
# Proměnné prostředí mají přednost před tímto souborem.

# --- knihovna ---------------------------------------------------------------
# Kořen dat. Uvnitř musí být Movies/, Series/, Anime/ a sorted/.
MEDIA_ROOT=/media/jellyfin

# --- Jellyfin ---------------------------------------------------------------
# Běží ve stejném LXC, takže localhost.
JELLYFIN_URL=http://127.0.0.1:8096
# Dashboard -> API Keys -> Add. Prázdné = refresh se přeskočí, appka běží dál.
JELLYFIN_API_KEY=
JELLYFIN_TIMEOUT=10

# --- přihlášení (HTTP Basic) ------------------------------------------------
APP_USER=admin
# POVINNÉ. Bez hesla appka odmítne každý request.
APP_PASSWORD=

# --- server -----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8181
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# --- nástroje ---------------------------------------------------------------
# Cesta k ffprobe, nebo jen "ffprobe", když je v PATH.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT=90
